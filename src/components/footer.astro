---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

import type { route } from "@/components/navigation.astro";


const routes = await getCollection("routes");

const lnks:route[] = routes.map((route: any) => route.data);
---

<footer class="w-full bg-accent grid md:grid-cols-3 bottom-0 relative">
    <div class="w-full flex flex-col gap-2 justify-between items-center">
        <p class="text-center text-lg font-sans flex flex-row gap-2 justify-center items-center">Made by <a href="https://bravegrumpy.com" class="btn-link" target="_blank">
            <Image src="https://cdn.bravegrumpy.com/static/assets/images/BraveGrumpyRectangle_color_typed.png" alt="BraveGrumpy" width={88} height={31} />
            <span class="text-lg font-serif">BraveGrumpy</span></a>
        </p>
        <h3 class="font-bold text-xl">Links</h3>
        <ul>
            {
                lnks.map((link: route) => {
                    return(
                        <li><a class="btn-link" href={link.href}>{link.text}</a></li>
                    )
                })
            }
        </ul>
    </div>
    <p class="text-center text-lg font-sans">Theme: <a href="https://tweakcn.com/themes/cmmsyjdm2000004jy9hdw16bg" target="_blank" rel="nofollow noreferrer noopen" class="btn-link">Magic 2 by "Vincent P"</a></p>
    <p class="text-center text-lg font-sans"><a href="https://blorbo.social/@bravegrumpy" class="btn-link">Follow me on Fedi!</a></p>
</footer>