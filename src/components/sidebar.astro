---
const pgs = Object.values(import.meta.glob("@/pages/*.astro", {eager: true}))
const posts = Object.values(import.meta.glob("@/pages/posts/**/*.md", { eager: true}))
---

<aside class="hidden md:block sidebar" data-side="left" aria-hidden="true">
    <nav aria-label="Sidebar navigation">
        <section class="sidebar-header">
        </section>
        <section class="scrollbar">
            <div role="group" aria-labelledby="group-label-content-1">
                <h3 id="group-label-content-1" class="font-serif text-3xl py-5 bg-accent/20 dark:bg-primary/10">Pages</h3>
                <ul>
                    {
                        pgs.length > 2 ? (
                            pgs.map((page: any) => {
                                if ((page.url !== "/404") && (page.url !== "")) {
                                    return (
                                        <li><a class="font-serif btn-link dark:text-primary text-primary-foreground" href={page.url}>{page.url}</a></li>
                                    )
                                }
                            })
                        ) : (<>
                            <li>No Links to Display</li>
                        </>)
                    }
                </ul>
            </div>
            <div role="group" aria-labelledby="group-label-content-2">
                <h3 id="group-label-content-2" class="font-serif text-3xl btn bg-accent dark:bg-accent dark:text-accent-foreground hover:dark:bg-secondary/30 shadow text-accent-foreground py-5 hover:bg-muted/80" onclick="toggleBlogPosts()">Blog Posts</h3>
                <ul id="blog-post-list" class="hidden">
                    {
                        posts.map((post: any) => {
                            return(
                                <li>
                                    <a class="btn-link font-sans dark:text-primary text-primary-foreground" href={post.url}>{post.frontmatter.title}</a>
                                </li>
                            )
                        })
                    }
                </ul>
            </div>
        </section>
    </nav>
</aside>

<script is:inline>
    function toggleBlogPosts() {
        const list = document.querySelector("#blog-post-list");
        if (list.classList.contains("hidden")) {
            list.classList.remove("hidden")
        } else {
            list.classList.add("hidden")
        }
    }
</script>


<button id="sidebar-trigger" type="button" onclick="document.dispatchEvent(new CustomEvent('basecoat:sidebar'))" class="hidden md:inline iconify size-8 icon-[streamline-plump-color--layout-right-sidebar] fixed" style="transition: left 300ms, margin-left 300ms; margin-left: -90px"></button>

<script is:inline>
    const sidebar = document.querySelector(".sidebar");
    const trigger = document.querySelector("#sidebar-trigger");

    sidebarWidth = sidebar?.offsetWidth ?? 0;
    sidebarMarginLeft = sidebar ? -90 : 0;

    function updatePosition() {
        if (!sidebar || !trigger) return;
        const isHidden = sidebar.getAttribute("aria-hidden") === "true";
        trigger.style.left = isHidden ? "0px" : `${sidebarWidth}px`;
        trigger.style.marginLeft = isHidden ? "0px" : `${sidebarMarginLeft}px`
    }

    new MutationObserver(updatePosition).observe(sidebar, {
        attributes: true,
        attributeFilter: ["aria-hidden"]
    })

    updatePosition();

    function tst() {
        alert("clicked")
    }

</script>