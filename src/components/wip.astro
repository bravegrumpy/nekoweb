<dialog id="wip-dialog" class="dialog" aria-labelledby="wip-dialog-title" open>
    <div>
        <header>
            <h3 id="wip-dialog-title">Work In Progress</h3>
        </header>
        <section>
            <p>By staying on this website, you are agreeing to peruse an unfinished piece of artwork. Please do so at your own discretion.</p>
        </section>
        <footer>
            <button class="btn" onclick="closeDialog()">Dismiss</button>
        </footer>
    </div>
</dialog>

<button 
    style="display: none" 
    class="btn" 
    id="show" 
    onclick="showDialog()"
    data-side="bottom"
    data-tooltip="Show the WIP Dialog"
>
    Show Dialog
</button>

<script is:inline>
    function closeDialog() {
        const dialog = document.querySelector("dialog")
        dialog.open = false;

        const btn = document.querySelector("button#show");
        btn.style.display = "inline";
    }

    function showDialog() {
        const dialog = document.querySelector("dialog");
        dialog.open = true;

        const btn = document.querySelector("button#show");
        btn.style.display = "none";
    }
</script>