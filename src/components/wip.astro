<dialog id="wip-dialog" class="dialog" aria-labelledby="wip-dialog-title" open>
    <div>
        <header>
            <h3 id="wip-dialog-title">Work In Progress</h3>
        </header>
        <section>
            <p>By staying on this website, you are agreeing to peruse an unfinished piece of artwork. Please do so at your own discretion.</p>
        </section>
        <footer>
            <button class="btn" onclick="closeDialog()">Dismiss</button>
        </footer>
    </div>
</dialog>

<button 
    style="display: none" 
    class="btn-icon size-8 iconify-color icon-[streamline-ultimate-color--car-dashboard-warning]" 
    id="show" 
    onclick="showDialog()"
    data-side="bottom"
    data-tooltip="Show the WIP Dialog"
>
    <span class="sr-only">
        Show WIP Warning
    </span>
</button>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const sawDialog = window.sessionStorage.getItem("saw-dialog") ? true : false;
        if (sawDialog) {
            closeDialog()
        }
    })
    function closeDialog() {
        const dialog = document.querySelector("dialog")
        dialog.open = false;
        window.sessionStorage.setItem("saw-dialog", true)

        const btn = document.querySelector("button#show");
        btn.style.display = "inline";
    }

    function showDialog() {
        const dialog = document.querySelector("dialog");
        dialog.open = true;

        const btn = document.querySelector("button#show");
        btn.style.display = "none";
    }
</script>