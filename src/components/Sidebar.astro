---
import { type link } from "@/components/Navigation.astro";

export interface sideLink extends link {
    icon?: string | false;
}

const allPosts = Object.values(import.meta.glob("@/pages/posts/**/*.md", { eager: true}));

interface Props {
  side?: "left" | "right";
  defaultState?: boolean;
  links: sideLink[];
}
const {
  side = "left",
  defaultState = false,
  links,
}: Props = Astro.props;
---

<aside class="sidebar hidden lg:block" data-side={side} aria-hidden={`${defaultState}`}>
  <nav aria-label="Sidebar navigation">
    <section class="scrollbar">
      {/*
      <div role="group" aria-labelledby="group-label-content-1">
        <h3 role="heading" id="group-label-content-1" class="text-xl font-serif">Navigation</h3>
        <ul>
          {
            links.map((lnk: sideLink) => {
              return (
                <li class="dark:bg-cyan-800 bg-green-100 flex flex-row gap-5 justify-around items-center">
                    <span class={`${lnk.icon} text-3xl`}></span>
                    <a href={lnk.href} class="inline text-center w-1/2">
                    {lnk.text}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
      */}
      <div role="group" aria-labelledby="group-label-content-3">
        <h3 role="heading" id="group-label-content-3" class="text-xl font-serif">Navigation</h3>
        <ul>
          {
            links.map((lnk: sideLink) => {
              return (
                <li class={`dark:bg-teal-800 bg-green-100 rounded-lg w-fit xl:w-full mx-auto`}>
                  <a href={lnk.href} class="w-full flex flex-row gap-3 justify-between items-center h-fit">
                    <span class={`${lnk.icon} size-10`}></span>
                    <span class="hidden 2xl:inline text-center w-1/2">{lnk.text}</span>
                  </a>
                </li>
              )
            })
          }
        </ul>
      </div>
      <div role="group" aria-labelledby="group-label-content-2">
        <h3 class="bg-accent text-accent-foreground" role="heading" id="group-label-content-2">Blog Posts</h3>
        <ul>
          {
            allPosts.map((post: any) => {
              if (post.url !== "/posts/post-1") {
                return (
                  <li>
                    <a href={post.url}>{post.frontmatter.title}</a>
                  </li>
                );
              }
            })
          }
        </ul>
      </div>
    </section>
  </nav>
</aside>
