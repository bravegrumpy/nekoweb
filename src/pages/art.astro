---
import { Image } from "astro:assets";
import Layout from "@/layouts/Base.astro";
const pageTitle = "Artwork"
const slug = "/art"

import { getCollection } from "astro:content";

const artwork = await getCollection("artwork")

import paintedField from "@/assets/images/painted_field.png";
import roadNotTaken from "@/assets/images/TheRoadNotTaken.png";
import dalek from "@/assets/images/DrDoodle_008.png";
import tablets from "@/assets/images/Tablets_Blank_04_0001.png"
import wolf from "@/assets/images/wolf_in_shadow.png"
---

<Layout pageTitle={pageTitle} slug={slug}>
    <div class="card bg-primary/50 shadow col-span-2 col-start-2" aria-labelledby="card-1-title">
        <header>
            <h2 id="card-title-1" class="text-2xl font-serif text-center text-primary-foreground">My Art</h2>
        </header>
        <section>
            <p>This page contains a subset of my artwork.  I'm working on adding stuff all the time. I work with both Blender and 3D, and 2D drawing. </p>
        </section>
    </div>

    {
        artwork.map((art) => {
            if (art.data.display) {
            return(<div class="card">
                <header>
                    <h2 set:html={art.data.title}></h2>
                    <p set:html={art.data.description}></p>
                </header>
                <section>
                    <Image src={art.data.image.src} alt={art.data.image.alt} width={art.data.image.width} height={art.data.image.height} />
                </section>
                <footer>
                    <p><em>{art.data.footer}</em></p>
                </footer>
            </div>)
            }
        })
    }
</Layout>
