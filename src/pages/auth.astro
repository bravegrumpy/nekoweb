---
import Layout from "@/layouts/Base.astro";

const pageTitle = "Auth"
const slug="/_auth"
---

<Layout pageTitle={pageTitle} slug={slug}>
	<div class="card 2xl:col-span-3 2xl:col-start-2 xl:col-span-2 xl:col-start-2 lg:col-span-3 lg:col-start-1 col-span-full">
		<header>
			<h2>Authentication</h2>
			<p>Please enter the password to access this page.</p>
		</header>
		<section>
			<!--# error -->
			<form method="post">
				<input class="input" type="password" placeholder="Password" />
				<button class="btn" type="submit">Submit</button>
			</form>
		</section>
	</div>
</Layout>