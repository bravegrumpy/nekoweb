---
import Layout from "@/layouts/Base.astro"
---

<Layout>
    <div class="card p-8">
        <header>
            <h2 class="text-2xl font-serif text-primary">Page Not Found</h2>
            <p>Error 404</p>
        </header>
        <section class="flex flex-col gap-3">
        <p>The page <span id="slug">/</span> does not exist.</p>
        <div class="border flex flex-col gap-5">
            Would you like to try a different page?
            <div class="flex flex-row gap-5">
                <input id="new-location" class="input" type="text" onchange="navigate()" />
                <button id="navigate" class="btn-outline" onclick="navigate()">Navigate</button>
            </div>
        </div>
        </section>
        <footer>
            <a class="btn" href="/">Go Home</a>
        </footer>

        <script is:inline>
            const slug = document.querySelector("#slug");
            slug.innerHTML = window.location ? `${decodeURI(window.location.pathname)}` : "/";

            const slugIn = document.querySelector("#new-location");

            function navigate() {
                window.location.href = encodeURI(slugIn.value);
            }
        </script>
    </div>
</Layout>