---
import Base from "@/layouts/Base.astro";

const pageTitle = "";

import { CurrentPath } from "@/components/react/current-path";

let pathName;
let path;
---

<Base pageTitle={pageTitle}>'
    <div class="w-1/3 mx-auto">
    <div class="card">
        <header>
            <h2 class="text-center text-2xl">Page Not Found</h2>
            <p>Error 404</p>
        </header>
        <section>
            <CurrentPath client:load>
            <p>Check the URL and try again.</p>
            </CurrentPath>
        </section>
        <footer>
            <a href="/" class="bg-primary text-lg py-1 text-primary-foreground px-5 w-fit mx-auto rounded-lg">Go Home</a>
        </footer>
    </div>
    </div>
</Base>