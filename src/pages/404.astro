---
import Base from "@/layouts/Base.astro"

const path = Astro.url.pathname;

import { Image } from "astro:assets";

const imgSrc1 = "https://www.startpage.com/av/proxy-image?piurl=https%3A%2F%2Fi.pinimg.com%2Foriginals%2Fb5%2F2b%2F12%2Fb52b12b1fc79808ed1686f51ab462330.jpg&sp=1770307615T5a39ee9f7f85527d061d3492dffcae8e7f555229ded0077ba07c9cabdac81816"

const imgSrc2 = "https://i.pinimg.com/736x/b5/2b/12/b52b12b1fc79808ed1686f51ab462330.jpg"

import localImgSrc from "@/images/DoryMeme.jpg";

---
<Base pageTitle="Page not Found">
    <div class="card bg-accent text-accent-foreground">
        <header>
            <h2>You seem to be lost</h2>
        </header>
        <section>
            <p>Unfortunately, the page {path ? path.substring(1) : "you are looking for"} seems to not exist.</p>
            <p>It is very possible that the page {path ? path.substring(1) : "you are looking for"} has not yet been build. You may have clicked on a link to get here, or you typed a pathname into your url bar that does not exist. </p>
            <div class="w-fit mx-auto">
                <Image 
                src={localImgSrc.src}
            alt="Just Keep Swimming finding nemo meme"
            width={300}
            height="200"
            />
            </div>
        </section>
        <footer class="flex flex-col gap-2">
            <h2 class="font-serif text-3xl">Begone!</h2>
            <a href="/" class="btn-primary">Swim back to shore!</a>
        </footer>
    </div>
</Base>