---
import "@/styles/global.css"

import Layout from "@/layouts/Base.astro";
import { Content as Rationale } from "./posts/rationale.md";
import { Content as Stack} from "./posts/using.md"
import { Content as Welcome } from "@/pages/posts/welcome.md"

const posts = Object.values(import.meta.glob("./posts/**/*.md", { eager: true }))
---

<Layout pageTitle="Home" slug="/">
	<Welcome embedded={true}/>
	<div class="2xl:col-span-2">
		<Rationale embedded={true}/>
	</div>
	<Stack />
	{
		posts.map((post: any) => {
			return(<>
				<a href={post.url} class="btn-link">{post.frontmatter.title}</a>
			</>);
		})
	}
</Layout>