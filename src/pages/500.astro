---
import Layout from "@/layouts/Base.astro"
interface Props {
    error: unknown;
}

const slug = Astro.url.pathname;
const { error } = Astro.props;
---

<Layout pageTitle={`${error instanceof Error ? error.message : "Error"}`} slug={slug}>
    <div class="card mb-25">
        <header>
            <h2 class="font-serif text-2xl text-primary">Error 500</h2>
            <p>Something went wrong.</p>
        </header>
        <section>
            {error instanceof Error ? error.message : "Unknown Error"}
        </section>
    </div>
</Layout>