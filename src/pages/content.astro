---
const pageTitle = "Content"
const currPage = "/content"
import { Content as Post } from "./posts/post-2.md";
import Base from "@/layouts/Base.astro";

const allPosts = Object.values(import.meta.glob("./posts/**/*.md", { eager: true }));
allPosts.sort((a, b) => b.frontmatter.id - a.frontmatter.id )
---

<Base pageTitle={pageTitle} currPage={currPage}>
    <div class="flex flex-col gap-6 mt-10">
        {
            allPosts.map((post) => {
                const Post = post.Content;
                return (
                    <div class="group/item border-2 py-5 px-10 rounded-xl flex flex-col gap-2 shadow shadow-gray-500/25">
                        <h3 class="text-2xl font-sans text-secondary-foreground bg-secondary">{post.frontmatter.title}</h3>
                        <Post />
                    </div>
                    <hr />
                )
            })
        }
    </div>
</Base>

