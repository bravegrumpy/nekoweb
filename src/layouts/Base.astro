---
import "@/styles/global.css"
import Fonts from "@/components/fonts.astro"

import { type route} from "@/components/navigation.astro";

import Header from "@/components/header.astro"
import Sidebar from "@/components/sidebar.astro";
import Footer from "@/components/footer.astro";

import Routes from "@/data/routes.json";

let links = Routes as route[];

const { pageTitle, slug } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle} | BraveGrumpy</title>
        <script>
            import "basecoat-css/all"
        </script>
        <link 
            rel="alternate"
            type="application/rss+xml",
            title={`${pageTitle} | BraveGrumpy`}
            href={new URL("/art/rss.xml", Astro.site)}
        />
        <Fonts />
	</head>
	<body>
        <Header navLinks={links} slug={slug}>
            <h1 class="text-3xl font-serif text-center text-primary">{pageTitle}</h1>
        </Header>
        <main class="masonry grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-10 px-5">
            <Sidebar />
            <slot />
        </main>
        <Footer />
	</body>
</html>
