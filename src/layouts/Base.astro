---
import { Font } from "astro:assets";

import "@/styles/global.css";

// import "@fontsource/capriola";
// import "@fontsource-variable/biorhyme";
// import "@fontsource-variable/martian-mono";

// import "@fontsource/numans"
// import "@fontsource/cormorant-upright";
// import "@fontsource/space-mono"

interface Props {
    pageTitle?: string;
	currPage?: string;
}
let { pageTitle, currPage="/" }: Props = Astro.props;

const title = pageTitle ? `${pageTitle} | BraveGrumpy` : `BraveGrumpy`;

import Navigation, { type link } from "@/components/Navigation.astro";
import Sidebar, { type sideLink } from "@/components/Sidebar.astro"

const strr = "icon-[streamline-freehand--home-chimney-2]"
const nav: sideLink[] = [
	{ href: "/", text: "Home", icon: "iconify-color icon-[streamline-emojis--house-with-garden]", group: 0 },
	{ href: "/bootstrap", text: "Bootstrap", icon: "iconify-color icon-[streamline-emojis--womans-boot]", group: 1},
	{ href: "/posts/post-1", text: "Post", icon: 'iconify-color icon-[streamline-stickies-color--pen-duo]', group: 1 },
	{ href: "/content", text: "Content", icon: "iconify-color icon-[streamline-ultimate-color--pen-write]", group: 1},
	{ href: "/about", text: "About", icon: "iconify-color icon-[streamline-stickies-color--online-information]", group: 2},
	{ href: '/ocean', text: "Ocean Theme", icon: "iconify-color icon-[streamline-ultimate-color--ice-water]", group: 1}
]
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script>
			import "basecoat-css/all"
		</script>
		<Font cssVariable="--font-coming-soon" />
		<Font cssVariable="--font-patrick-hand" />
		<Font cssVariable="--font-indie-flower" />
		<Font cssVariable="--font-alegrya"/>
		<Font cssVariable="--font-bree-serif" />
		<Font cssVariable="--font-kode-mono" />
		<Font cssVariable="--font-capriola" />
		<Font cssVariable="--font-bio-rhyme" />
		<Font cssVariable="--font-martian-mono" />
		<Font cssVariable="--font-numans" />
		<Font cssVariable="--font-cormorant-upright" />
		<Font cssVariable="--font-space-mono" />
		<script>
			(() => {
				try {
					const stored = localStorage.getItem('themeMode')
					if (
						stored ? 
						stored === 'dark' : 
						matchMedia(`(prefers-color-scheme: dark)`).matches) {
							document.documentElement.classList.add('dark')
					}
				} catch(_){}
				
				const apply = (dark: boolean) => {
					document.documentElement.classList.toggle('dark', dark);
					try {
						localStorage.setItem('themeMode', dark ? 'dark' : 'light')
					} catch(_){}
				};
				
				document.addEventListener('basecoat:theme', (event) => {
					//@ts-expect-error
					const mode = event.detail?.mode;
					apply(mode === 'dark' ? true
					: mode === 'light' ? false
					: !document.documentElement.classList.contains('dark')
				)
			})
			})();
		</script>
	</head>
	<body class="bg-background max-w-[500px] lg:max-w-[600px] xl:max-w-[800px] mx-auto 2xl:max-w-[1000px] 3xl:max-w-[1800px]">
		<Sidebar side="left" defaultState={false} links={nav} />
		<Navigation links={nav} currPage={currPage}/>
		<h1 class="font-bold text-3xl text-foreground">{pageTitle}</h1>
        <slot />
	</body>
</html>

