---
import "@/styles/global.css"
import "@fontsource/coming-soon"
import "@fontsource/patrick-hand"
import "@fontsource/indie-flower"

interface Props {
    pageTitle?: string;
}
let { pageTitle }: Props = Astro.props;

const title = pageTitle ? `${pageTitle} | BraveGrumpy` : `BraveGrumpy`;

import Navigation, { type link } from "@/components/Navigation.astro";
import Sidebar, { type sideLink } from "@/components/Sidebar.astro"

const nav: sideLink[] = [
	{ href: "/", text: "Home", icon: "iconify-color icon-[streamline-freehand-color--home-chimney-2] bg-amber-100" },
	// { href: "/bootstrap", text: "Bootstrap" }
	// { href: "/posts/post-1", text: "Post", icon: 'iconify-color icon-[streamline-stickies-color--pen-duo]' }
	{ href: "/content", text: "Content", icon: "iconify icon-[streamline-freehand--content-paper-edit]"}
]
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script>
			import "basecoat-css/all"
		</script>
		<script>
			(() => {
				try {
					const stored = localStorage.getItem('themeMode')
					if (
						stored ? 
						stored === 'dark' : 
						matchMedia(`(prefers-color-scheme: dark)`).matches) {
							document.documentElement.classList.add('dark')
					}
				} catch(_){}
				
				const apply = (dark: boolean) => {
					document.documentElement.classList.toggle('dark', dark);
					try {
						localStorage.setItem('themeMode', dark ? 'dark' : 'light')
					} catch(_){}
				};
				
				document.addEventListener('basecoat:theme', (event) => {
					//@ts-expect-error
					const mode = event.detail?.mode;
					apply(mode === 'dark' ? true
					: mode === 'light' ? false
					: !document.documentElement.classList.contains('dark')
				)
			})
			})();
		</script>
	</head>
	<body class="bg-background w-[500px] mx-auto my-0">
		<Sidebar side="left" defaultState={false} links={nav} />
		<Navigation links={nav}/>
		<h1 class="font-bold text-3xl text-foreground">{pageTitle}</h1>
        <slot />
	</body>
</html>

