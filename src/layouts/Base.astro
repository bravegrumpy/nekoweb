---
import "@/styles/global.css"
import "@fontsource/coming-soon"
import "@fontsource/patrick-hand"
import "@fontsource/indie-flower"

interface Props {
    pageTitle?: string;
}
let { pageTitle }: Props = Astro.props;

const title = pageTitle ? `${pageTitle} | BraveGrumpy` : `BraveGrumpy`
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.png" />
		<!-- <link rel="icon" href="/favicon.ico" /> -->
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script>
			import "basecoat-css/all"
		</script>
		<script>
			(() => {
				try {
					const stored = localStorage.getItem('themeMode')
					if (
						stored ? 
						stored === 'dark' : 
						matchMedia(`(prefers-color-scheme: dark)`).matches) {
							document.documentElement.classList.add('dark')
					}
				} catch(_){}
				
				const apply = (dark: boolean) => {
					document.documentElement.classList.toggle('dark', dark);
					try {
						localStorage.setItem('themeMode', dark ? 'dark' : 'light')
					} catch(_){}
				};
				
				document.addEventListener('basecoat:theme', (event) => {
					const mode = event.detail?.mode;
					apply(mode === 'dark' ? true
					: mode === 'light' ? false
					: !document.documentElement.classList.contains('dark')
				)
			})
			})();
		</script>
	</head>
	<body class="bg-background w-[500px] mx-auto my-0">
		<h1 class="font-bold text-3xl text-foreground">{pageTitle}</h1>
        <slot />
	</body>
</html>

