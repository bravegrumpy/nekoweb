---
import "@/styles/global.css"
import "@fontsource/coming-soon"
import "@fontsource/patrick-hand"
import "@fontsource/indie-flower"

interface Props {
    pageTitle?: string;
}
let { pageTitle }: Props = Astro.props;

const title = pageTitle ? `${pageTitle} | BraveGrumpy` : `BraveGrumpy`
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.png" />
		<!-- <link rel="icon" href="/favicon.ico" /> -->
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script>
			import "basecoat-css/all"
		</script>
		<script src="https://tweakcn.com/live-preview.min.js"></script>
		<script src="/scripts/themeToggle.js" is:inline></script>
	</head>
	<body class="bg-background w-[500px] mx-auto my-0">
		<h1>{pageTitle}</h1>
        <slot />
	</body>
</html>

